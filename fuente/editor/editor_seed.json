re norte)","open":false,"grp":null},{"id":"s9_0","type":"switch","on":"TRNWl","s":5,"name":"Cruce central → oeste (alambre sur)","open":false,"grp":null},{"id":"s10_0","type":"switch","on":"c_S2","s":5,"name":"Cruce central → suroeste","open":false,"grp":null},{"id":"s11_0","type":"switch","on":"c_S1","s":5,"name":"Cruce central → sureste","open":false,"grp":null},{"id":"s13_0","type":"switch","on":"M0","s":5,"name":"Nodo suroeste","open":false,"grp":null},{"id":"s14_0","type":"switch","on":"S5","s":5,"name":"Nodo suroeste → sur","open":false,"grp":null},{"id":"s7_0","type":"switch","on":"WX","s":5,"name":"Potrero oeste","open":false,"grp":null},{"id":"s12_0","type":"switch","on":"PER_S","s":5,"name":"Perímetro, esquina oeste","open":false,"grp":null},{"id":"g0","type":"gate","x":732,"y":160},{"id":"g1","type":"gate","x":546,"y":299},{"id":"g2","type":"gate","x":515,"y":356},{"id":"g3","type":"gate","x":452,"y":377},{"id":"g4","type":"gate","x":367,"y":464},{"id":"g5","type":"gate","x":343,"y":443},{"id":"g6","type":"gate","x":581,"y":498},{"id":"g7","type":"gate","x":465,"y":550},{"id":"g8","type":"gate","x":312,"y":510},{"id":"g9","type":"gate","x":261,"y":525},{"id":"g10","type":"gate","x":242,"y":573},{"id":"g11","type":"gate","x":341,"y":564},{"id":"g12","type":"gate","x":348,"y":641},{"id":"g13","type":"gate","x":291,"y":655},{"id":"g14","type":"gate","x":161,"y":655},{"id":"g15","type":"gate","x":188,"y":623},{"id":"g16","type":"gate","x":202,"y":770},{"id":"g17","type":"gate","x":318,"y":766},{"id":"g18","type":"gate","x":229,"y":866},{"id":"g19","type":"gate","x":498,"y":873},{"id":"q3","type":"note","by":"claude","x":505,"y":424,"text":"?3 Esta marca amarilla gruesa sobre el camino la tomé como cablecito sobre una puerta, no como rayito. ¿Correcto?","answer":""},{"id":"q4","type":"note","by":"claude","x":404,"y":528,"text":"?4 Este switch me quedó como el principal: corta el camino, el centro y todo el sur (unos 8 km). ¿Es así, o solo corta el camino?","answer":""},{"id":"q5","type":"note","by":"claude","x":417,"y":509,"text":"?5 ¿Este switch corta solo el ramal que va hacia la casa, o todo el alambre norte del camino?","answer":""},{"id":"q6","type":"note","by":"claude","x":406,"y":365,"text":"?6 Hay una rayita roja en el callejón. La puse como switch que corta los dos alambres del callejón hacia el norte. ¿Es un switch?","answer":""},{"id":"q7","type":"note","by":"claude","x":507,"y":588,"text":"?7 Centro: supuse que el alambre norte del callejón brinca la puerta y sube por el alambre de afuera hasta la línea del perímetro este, y que el switch corta la troncal y la línea al sureste.","answer":""},{"id":"q8","type":"note","by":"claude","x":384,"y":704,"text":"?8 Aquí conté 4 switches: dos hacia el oeste (uno por alambre), uno al suroeste y uno al sureste. ¿Son 4?","answer":""},{"id":"q9","type":"note","by":"claude","x":248,"y":854,"text":"?9 Nodo suroeste: puse el switch de arriba cortando todo el nodo (línea oeste, línea al este y línea al sur).","answer":""},{"id":"q10","type":"note","by":"claude","x":318,"y":516,"text":"?10 Zona de la casa, cobertizo y corral: es donde menos seguro estoy de qué se conecta con qué.","answer":""},{"id":"q11","type":"note","by":"claude","x":39,"y":756,"text":"?11 Rayita roja en la esquina oeste del perímetro: la puse como switch que corta el lado sur y este del perímetro.","answer":""},{"id":"q12","type":"note","by":"claude","x":197,"y":910,"text":"?12 Tres ramales salen del perímetro hacia adentro (este, el del potrero oeste y el del corral). Los puse en el circuito del perímetro.","answer":""},{"id":"q13","type":"note","by":"claude","x":485,"y":288,"text":"?13 Vi signos de interrogación tuyos en los potreros del norte y junto al ramal oeste. ¿Falta algo ahí?","answer":""}]}