s":23.9}},{"id":"g15","type":"gate","a":{"on":"WX","s":92.2},"b":{"on":"CW1a","s":0}},{"id":"g16","type":"gate","a":{"on":"W1","s":81.2},"b":{"on":"L1","s":222.6}},{"id":"g17","type":"gate","a":{"on":"S3","s":92.1},"b":{"on":"S2","s":73.3}},{"id":"g18","type":"gate","a":{"on":"M0","s":23.6},"b":{"on":"S6","s":122.1}},{"id":"g19","type":"gate","a":{"on":"PER_S","s":801.7},"b":{"on":"S4","s":224.2}},{"id":"q3","type":"note","by":"claude","x":505,"y":424,"text":"?3 Esta marca amarilla gruesa sobre el camino la tomé como cablecito sobre una puerta, no como rayito. ¿Correcto?","answer":""},{"id":"q4","type":"note","by":"claude","x":404,"y":528,"text":"?4 Este switch me quedó como el principal: corta el camino, el centro y todo el sur (unos 8 km). ¿Es así, o solo corta el camino?","answer":""},{"id":"q5","type":"note","by":"claude","x":417,"y":509,"text":"?5 ¿Este switch corta solo el ramal que va hacia la casa, o todo el alambre norte del camino?","answer":""},{"id":"q6","type":"note","by":"claude","x":406,"y":365,"text":"?6 Hay una rayita roja en el callejón. La puse como switch que corta los dos alambres del callejón hacia el norte. ¿Es un switch?","answer":""},{"id":"q7","type":"note","by":"claude","x":507,"y":588,"text":"?7 Centro: supuse que el alambre norte del callejón brinca la puerta y sube por el alambre de afuera hasta la línea del perímetro este, y que el switch corta la troncal y la línea al sureste.","answer":""},{"id":"q8","type":"note","by":"claude","x":384,"y":704,"text":"?8 Aquí conté 4 switches: dos hacia el oeste (uno por alambre), uno al suroeste y uno al sureste. ¿Son 4?","answer":""},{"id":"q9","type":"note","by":"claude","x":248,"y":854,"text":"?9 Nodo suroeste: puse el switch de arriba cortando todo el nodo (línea oeste, línea al este y línea al sur).","answer":""},{"id":"q10","type":"note","by":"claude","x":318,"y":516,"text":"?10 Zona de la casa, cobertizo y corral: es donde menos seguro estoy de qué se conecta con qué.","answer":""},{"id":"q11","type":"note","by":"claude","x":39,"y":756,"text":"?11 Rayita roja en la esquina oeste del perímetro: la puse como switch que corta el lado sur y este del perímetro.","answer":""},{"id":"q12","type":"note","by":"claude","x":197,"y":910,"text":"?12 Tres ramales salen del perímetro hacia adentro (este, el del potrero oeste y el del corral). Los puse en el circuito del perímetro.","answer":""},{"id":"q13","type":"note","by":"claude","x":485,"y":288,"text":"?13 Vi signos de interrogación tuyos en los potreros del norte y junto al ramal oeste. ¿Falta algo ahí?","answer":""}]}